# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/easygen-auth

# JWT access token (short-lived, stored in an httpOnly cookie)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900

# Refresh session lifetime (opaque token, rotated on every use)
REFRESH_TTL_DAYS=7

# Comma-separated origins allowed to call the API with credentials (only needed when
# the web app is served from a different origin, e.g. the Vite dev server)
CORS_ORIGINS=http://localhost:5173
